SETTLEGRAPH_DEFAULT_CURRENCY=INR
SETTLEGRAPH_RANDOM_SEED=42
SETTLEGRAPH_AUTO_MATCH_THRESHOLD=0.95
SETTLEGRAPH_EXCEPTION_THRESHOLD=0.70
SETTLEGRAPH_LLM_PROVIDER=none

# --- Optional AI features (install with: pip install -e ".[dev,llm]") ---
# Local / personal use only. The Claude Agent SDK subscription path is licensed
# for individual use and must NOT back a public or multi-user deployment
# (Anthropic Agent SDK terms). The hosted Vercel app stays read-only.
# Never commit real credentials — .env is gitignored; keep these commented here.
#
# Pick ONE credential:
#   1) Anthropic API key — powers both the AI reasoner and the Q&A agent:
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
#   2) Claude Pro/Max subscription token — Q&A agent only, via `claude setup-token`:
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat-xxxxxxxx
#
# To also enable the reconciliation AI reasoner (needs an API key, not a subscription):
# SETTLEGRAPH_LLM_PROVIDER=claude

